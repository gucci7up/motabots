# ─────────────────────────────────────────────────────────────
# MotaParfum Admin — variables de entorno
# Copia este archivo a .env y complétalo. NUNCA subas .env a git.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# URL pública de la aplicación (usada para registrar el webhook de Telegram)
APP_URL=

# Zona horaria usada para el corte de reportes y cierres de caja
TZ=America/Santo_Domingo

# ── Base de datos ────────────────────────────────────────────
# Conexión usada por la aplicación (puede pasar por un pooler)
#
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=public
# Si la clave contiene @ : / ? # o &, codifícala (por ejemplo @ → %40).
#
# Contra una base REMOTA añade estos parámetros; con los valores por defecto Prisma
# intenta abrir 13 conexiones en 10 s y con latencia alta falla con P2024:
#   &connect_timeout=30&connection_limit=5&pool_timeout=30
DATABASE_URL=
# Conexión directa a PostgreSQL, usada por las migraciones de Prisma
DIRECT_URL=

# ── Telegram ─────────────────────────────────────────────────
# Token del bot entregado por @BotFather
TELEGRAM_BOT_TOKEN=
# IDs numéricos de Telegram con acceso de administrador, separados por coma
TELEGRAM_ADMIN_IDS=
# Secreto que Telegram enviará en la cabecera X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# polling (desarrollo) | webhook (producción)
TELEGRAM_MODE=polling

# ── Seguridad ────────────────────────────────────────────────
# Secreto para firmar JWT del futuro dashboard web (mínimo 32 caracteres)
JWT_SECRET=

# ── Redis (opcional) ─────────────────────────────────────────
# Si se omite, las sesiones del bot usan memoria local (sólo desarrollo)
REDIS_URL=

# ── Almacenamiento de archivos ───────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ── Datos de la tienda (valores iniciales del seed) ──────────
STORE_NAME=MotaParfum
STORE_PHONE=
STORE_ADDRESS=
CURRENCY=DOP
CURRENCY_SYMBOL=RD$

# ── Logging ──────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
